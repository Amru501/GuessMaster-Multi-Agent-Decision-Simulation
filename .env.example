# Ollama server URL (default shown below)
OLLAMA_HOST=http://localhost:11434

# Required: name of an installed local model (run `ollama list` to check)
OLLAMA_MODEL=qwen2.5:3b

# HTTP request timeout in seconds; increase if cold model loads are slow (default: 180)
OLLAMA_TIMEOUT_SECONDS=180

# How long Ollama keeps the model loaded in memory after each request (default: 10m)
OLLAMA_KEEP_ALIVE=10m
